@baseUrl = http://localhost:5229
@model = qwen3.5:9b
@databaseId = access-control-demo

### List available report databases
GET {{baseUrl}}/api/reports/databases

### Inspect the access-control schema
GET {{baseUrl}}/api/reports/schema?databaseId={{databaseId}}

### Count denied swipes by site
POST {{baseUrl}}/api/reports/query
Content-Type: application/json

{
  "databaseId": "{{databaseId}}",
  "model": "{{model}}",
  "question": "Count denied swipe attempts by site. Join swipes.reader_id to readers.reader_id, readers.door_id to doors.door_id, and doors.site_id to sites.site_id. Do not join cards or attendance_records. Filter access_result = DENIED and swipe_time_utc from 2026-11-16 inclusive to 2026-11-19 exclusive. Return site_name and the count, highest count first."
}

### Show daily attendance for a specific date
POST {{baseUrl}}/api/reports/query
Content-Type: application/json

{
  "databaseId": "{{databaseId}}",
  "model": "{{model}}",
  "question": "For 2026-11-16, list each cardholder's name, site name, attendance status, first entry time, last exit time, and minutes on site. Join attendance_records.cardholder_id to cardholders.cardholder_id and attendance_records.site_id to sites.site_id."
}

### Review door alarms and warnings
POST {{baseUrl}}/api/reports/query
Content-Type: application/json

{
  "databaseId": "{{databaseId}}",
  "model": "{{model}}",
  "question": "List door activities with severity ALARM or WARNING from 2026-11-16 through 2026-11-18. Include site, door, event time, event type, severity, and details. Join door_activities.door_id to doors.door_id and doors.site_id to sites.site_id."
}

### Review cardholder activity
POST {{baseUrl}}/api/reports/query
Content-Type: application/json

{
  "databaseId": "{{databaseId}}",
  "model": "{{model}}",
  "question": "List cardholder activity from 2026-11-10 through 2026-11-18 with cardholder name, department, event time, event type, details, and performed by. Join cardholder_activities.cardholder_id to cardholders.cardholder_id."
}
